QWidget {
    background-color: #2b2b2b;
    color: #f0f0f0;
    font-family: Segoe UI;
}

QPushButton {
    background-color: #3a3a3a;
    border: 1px solid #555;
    padding: 6px 10px;
    border-radius: 4px;
    color: #f0f0f0;
    text-align: center;
    font-size: 14px;
}

QPushButton:hover {
    background-color: #4c4c4c;
}

#HeaderWidget {
    background-color: #3a3a3a;
    border-bottom: 1px solid #666;
}

PacketWidget {
    background-color: #3a3a3a;
    border: 1px solid #ddd;
    border-radius: 2px;
}

PacketWidget:hover {
    background-color: #4c4c4c;
}

QLabel {
    padding: 2px;
    border: none;
}
